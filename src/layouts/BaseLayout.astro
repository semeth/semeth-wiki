---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import { getModpacks, getMods } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
}

const mods = await getMods();
const modpacks = await getModpacks();
const { title, description = site.description, accent = '#d4a54a' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,400&family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;0,900;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        if (!window.matchMedia('(min-width: 1280px)').matches) return;
        const script = document.createElement('script');
        script.async = true;
        script.src =
          'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4573849572078686';
        script.crossOrigin = 'anonymous';
        document.head.appendChild(script);
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased" style={`--mod-accent: ${accent}`}>
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -left-24 -top-28 h-80 w-80 rounded-full blur-3xl opacity-30"
        style={`background: radial-gradient(circle, ${accent} 0%, transparent 70%)`}
      >
      </div>
      <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-gold/10 blur-3xl"></div>
    </div>
    <Header mods={mods} modpacks={modpacks} />
    <main class="min-w-0 overflow-x-clip" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
