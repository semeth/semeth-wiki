---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import { getModpacks, getMods } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
}

const mods = await getMods();
const modpacks = await getModpacks();
const { title, description = site.description, accent = '#d4a54a' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,400&family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;0,900;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen antialiased" style={`--mod-accent: ${accent}`}>
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -left-24 -top-28 h-80 w-80 rounded-full blur-3xl opacity-30"
        style={`background: radial-gradient(circle, ${accent} 0%, transparent 70%)`}
      >
      </div>
      <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-gold/10 blur-3xl"></div>
    </div>
    <Header mods={mods} modpacks={modpacks} />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline src="https://pl31393193.profitableratecpmnetwork.com/b5/3e/fb/b53efb62df57546390e85856a0bd72b9.js"></script>
          <script is:inline src="https://pl31393194.profitableratecpmnetwork.com/d5/1a/8e/d51a8eaa25dfac0b66fc32b7f6301b64.js"></script>
        </>
      )
    }
  </body>
</html>
