---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../lib/site';
import ModLogo from './ModLogo.astro';

interface Props {
  mods: CollectionEntry<'mods'>[];
  modpacks?: CollectionEntry<'modpacks'>[];
}

const { mods, modpacks = [] } = Astro.props;
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-obsidian/80 backdrop-blur-md" data-pagefind-ignore>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-baseline gap-2">
      <span class="font-display text-2xl font-semibold tracking-wide text-parchment">Semeth</span>
      <span class="text-xs uppercase tracking-[0.22em] text-gold">Wiki</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-muted md:flex">
      <details class="relative">
        <summary class="cursor-pointer list-none text-parchment/90 hover:text-gold-soft">
          Mods
        </summary>
        <div class="absolute right-0 mt-3 max-h-[70vh] w-72 overflow-y-auto rounded-xl border border-line bg-surface p-2 shadow-2xl">
          {
            mods.map((mod) => (
              <a
                href={`/mods/${mod.id}`}
                class="flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-raised"
              >
                <ModLogo mod={mod} size="sm" />
                <div>
                  <div class="text-sm text-parchment">{mod.data.name}</div>
                  <div class="text-xs text-muted">{categoryLabels[mod.data.category]}</div>
                </div>
              </a>
            ))
          }
        </div>
      </details>
      {
        modpacks.length > 0 && (
          <details class="relative">
            <summary class="cursor-pointer list-none text-parchment/90 hover:text-gold-soft">
              Modpacks
            </summary>
            <div class="absolute right-0 mt-3 w-80 rounded-xl border border-line bg-surface p-2 shadow-2xl">
              {modpacks.map((pack) => (
                <a
                  href={`/modpacks/${pack.id}`}
                  class="flex items-center gap-3 rounded-lg px-3 py-2 hover:bg-raised"
                >
                  <ModLogo mod={pack} size="sm" kind="modpack" />
                  <div>
                    <div class="text-sm text-parchment">{pack.data.name}</div>
                    <div class="text-xs text-muted">
                      {pack.data.loader} · {pack.data.minecraftVersions[0]}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </details>
        )
      }
      <a class:list={['hover:text-gold-soft', path.startsWith('/updates') && 'text-gold-soft']} href="/updates">
        Updates
      </a>
      <a class:list={['hover:text-gold-soft', path.startsWith('/about') && 'text-gold-soft']} href="/about">
        About
      </a>
      <a
        href="/search"
        class:list={[
          'rounded-full border border-line px-3 py-1.5 text-parchment hover:border-gold/60 hover:text-gold-soft',
          path.startsWith('/search') && 'border-gold/60 text-gold-soft',
        ]}
      >
        Search
      </a>
    </nav>

    <a href="/search" class="rounded-full border border-line px-3 py-1.5 text-sm md:hidden">Search</a>
  </div>
  <div class="flex gap-3 overflow-x-auto border-t border-line px-4 py-2 text-xs text-muted md:hidden">
    {
      mods.map((mod) => (
        <a class="flex shrink-0 items-center gap-2 whitespace-nowrap hover:text-gold-soft" href={`/mods/${mod.id}`}>
          <ModLogo mod={mod} size="sm" />
          {mod.data.name}
        </a>
      ))
    }
    {
      modpacks.map((pack) => (
        <a class="flex shrink-0 items-center gap-2 whitespace-nowrap hover:text-gold-soft" href={`/modpacks/${pack.id}`}>
          <ModLogo mod={pack} size="sm" kind="modpack" />
          {pack.data.name}
        </a>
      ))
    }
    <a class="whitespace-nowrap hover:text-gold-soft" href="/updates">Updates</a>
    <a class="whitespace-nowrap hover:text-gold-soft" href="/about">About</a>
  </div>
</header>
