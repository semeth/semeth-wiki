---
import type { CollectionEntry } from 'astro:content';
import { formatDownloads } from '../lib/format';
import { categoryLabels } from '../lib/site';
import type { ProjectKind } from '../lib/content';
import ModLogo from './ModLogo.astro';

interface Props {
  mod: CollectionEntry<'mods'> | CollectionEntry<'modpacks'>;
  downloads?: number | null;
  latestVersion?: string | null;
  kind?: ProjectKind;
}

const { mod, downloads = null, latestVersion = null, kind = 'mod' } = Astro.props;
const countLabel = downloads != null ? `${formatDownloads(downloads)} downloads` : null;
const href = kind === 'modpack' ? `/modpacks/${mod.id}` : `/mods/${mod.id}`;
const kindLabel =
  kind === 'modpack' ? 'Modpack' : categoryLabels[(mod as CollectionEntry<'mods'>).data.category];
---

<article
  class="group relative overflow-hidden rounded-2xl border border-line bg-surface/80 transition hover:border-white/20"
  style={`--card-accent: ${mod.data.accent}`}
>
  <div
    class="absolute inset-x-0 top-0 h-1"
    style="background: var(--card-accent)"
  >
  </div>
  <a href={href} class="block p-5">
    <div class="mb-4 flex items-start justify-between gap-3">
      <ModLogo mod={mod} size="md" kind={kind} />
      <span class="text-xs uppercase tracking-wider text-muted">{kindLabel}</span>
    </div>
    <h3 class="break-words font-display text-2xl text-white">{mod.data.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{mod.data.tagline}</p>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-muted">
      {latestVersion && <span class="break-words text-gold-soft">{latestVersion}</span>}
      <span>{mod.data.loader}</span>
      {mod.data.minecraftVersions[0] && <span>{mod.data.minecraftVersions[0]}</span>}
      {countLabel && <span class="text-gold-soft">{countLabel}</span>}
    </div>
  </a>
  <div class="flex items-center justify-between border-t border-line px-5 py-3 text-xs">
    <a href={href} class="text-parchment/80 hover:text-gold-soft">Open guide</a>
    <a
      href={mod.data.curseforgeUrl}
      target="_blank"
      rel="noreferrer"
      class="text-gold hover:text-gold-soft"
    >
      CurseForge
    </a>
  </div>
</article>
