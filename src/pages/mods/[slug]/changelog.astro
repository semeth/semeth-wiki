---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChangelogList from '../../../components/ChangelogList.astro';
import CurseForgeButton from '../../../components/CurseForgeButton.astro';
import ModNav from '../../../components/ModNav.astro';
import { getDownloadCount, getProjectReleases } from '../../../lib/curseforge';
import { getGuidesForMod, getMods } from '../../../lib/content';

export async function getStaticPaths() {
  const mods = await getMods();
  return mods.map((mod) => ({ params: { slug: mod.id } }));
}

const { slug } = Astro.params;
const mods = await getMods();
const mod = mods.find((entry) => entry.id === slug);
if (!mod) {
  return Astro.redirect('/');
}

const guides = await getGuidesForMod(mod.id);
const releases = await getProjectReleases(mod.data.curseforgeProjectId);
const downloads = await getDownloadCount(mod.data.curseforgeProjectId);
---

<BaseLayout title={`Changelog · ${mod.data.name}`} description={`Update history for ${mod.data.name}.`} accent={mod.data.accent}>
  <div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[16rem_minmax(0,1fr)] sm:px-6">
    <ModNav mod={mod} guides={guides} current="changelog" />
    <article class="min-w-0 overflow-x-clip">
      <p class="text-xs uppercase tracking-wider text-gold sm:tracking-[0.28em]">
        <a href={`/mods/${mod.id}`} class="break-words hover:text-gold-soft">{mod.data.name}</a>
      </p>
      <h1 class="mt-3 font-display text-4xl text-white sm:text-5xl">Changelog</h1>
      <p class="mt-3 text-sm text-muted">Every CurseForge file, newest first.</p>
      <div class="mt-6">
        <CurseForgeButton mod={mod} downloads={downloads} />
      </div>
      <ChangelogList releases={releases} curseforgeUrl={mod.data.curseforgeUrl} />
    </article>
  </div>
</BaseLayout>
