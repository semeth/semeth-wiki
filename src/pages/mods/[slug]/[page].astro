---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModNav from '../../../components/ModNav.astro';
import { getGuide, getGuidesForMod, getMods } from '../../../lib/content';

export async function getStaticPaths() {
  const mods = await getMods();
  const paths = [];
  for (const mod of mods) {
    const guides = await getGuidesForMod(mod.id);
    for (const guide of guides) {
      paths.push({
        params: { slug: mod.id, page: guide.data.pageSlug },
      });
    }
  }
  return paths;
}

const { slug, page } = Astro.params;
const mods = await getMods();
const mod = mods.find((entry) => entry.id === slug);
if (!mod || !page) {
  return Astro.redirect('/');
}

const guides = await getGuidesForMod(mod.id);
const guide = await getGuide(mod.id, page);
if (!guide) {
  return Astro.redirect(`/mods/${mod.id}`);
}

const { Content } = await render(guide);
const index = guides.findIndex((entry) => entry.id === guide.id);
const prev = index > 0 ? guides[index - 1] : undefined;
const next = index >= 0 && index < guides.length - 1 ? guides[index + 1] : undefined;
---

<BaseLayout title={`${guide.data.title} · ${mod.data.name}`} description={mod.data.tagline} accent={mod.data.accent}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[16rem_minmax(0,1fr)] sm:px-6">
    <ModNav mod={mod} guides={guides} current={guide.data.pageSlug} />
    <article>
      <p class="text-xs uppercase tracking-[0.28em] text-gold">
        <a href={`/mods/${mod.id}`} class="hover:text-gold-soft">{mod.data.name}</a>
      </p>
      <h1 class="mt-3 font-display text-5xl text-white">{guide.data.title}</h1>
      <div class="prose-wiki mt-8">
        <Content />
      </div>
      <nav class="mt-12 flex justify-between gap-4 border-t border-line pt-6 text-sm">
        {
          prev ? (
            <a class="text-gold hover:text-gold-soft" href={`/mods/${mod.id}/${prev.data.pageSlug}`}>
              ← {prev.data.title}
            </a>
          ) : (
            <a class="text-muted hover:text-gold-soft" href={`/mods/${mod.id}`}>
              ← Overview
            </a>
          )
        }
        {
          next ? (
            <a class="text-gold hover:text-gold-soft" href={`/mods/${mod.id}/${next.data.pageSlug}`}>
              {next.data.title} →
            </a>
          ) : (
            <a class="text-gold hover:text-gold-soft" href={`/mods/${mod.id}/changelog`}>
              Changelog →
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>
