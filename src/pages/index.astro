---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModCard from '../components/ModCard.astro';
import { site, categoryLabels } from '../lib/site';
import { getModsWithStats, getModpacksWithStats, getAllChangelogs, groupMods } from '../lib/content';
import { formatDate } from '../lib/format';

const mods = await getModsWithStats();
const modpacks = await getModpacksWithStats();
const groups = groupMods(mods);
const latest = (await getAllChangelogs()).slice(0, 5);
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-16 sm:px-6">
    <p class="text-xs uppercase tracking-[0.28em] text-gold">Mods · SC Final Adventure packs</p>
    <h1 class="mt-4 max-w-3xl font-display text-5xl leading-tight text-white sm:text-6xl">
      {site.name}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      Guides for how these mods work, and a changelog for every update. Iron’s Spellbooks addons, adventure and
      structure tools, pack-author kits, Cataclysm extras, a TikTok LIVE bridge, and the SC Final Adventure modpacks.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
        <h2 class="mb-5 font-display text-3xl text-white">{categoryLabels[group.category]}</h2>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {group.mods.map((mod) => (
            <ModCard mod={mod} downloads={mod.downloads} />
          ))}
        </div>
      </section>
    ))
  }

  {
    modpacks.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
        <h2 class="mb-5 font-display text-3xl text-white">Modpacks</h2>
        <p class="mb-5 max-w-2xl text-sm text-muted">
          The SC Final Adventure family — bossrush, Arcana, Machines, and Mechanical Genesis. Each pack has its own
          guides and changelog.
        </p>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {modpacks.map((pack) => (
            <ModCard mod={pack} downloads={pack.downloads} kind="modpack" />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl text-white">Latest updates</h2>
      <a href="/updates" class="text-sm text-gold hover:text-gold-soft">All changelogs</a>
    </div>
    <ul class="mt-6 divide-y divide-line rounded-2xl border border-line bg-surface/60">
      {
        latest.map((entry) => (
          <li class="px-5 py-4">
            <a href={entry.href} class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <p class="text-sm text-gold-soft">{entry.projectName} · {entry.version}</p>
                <p class="mt-1 text-parchment">{entry.summary}</p>
              </div>
              <time class="text-xs text-muted" datetime={entry.date.toISOString()}>
                {formatDate(entry.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
