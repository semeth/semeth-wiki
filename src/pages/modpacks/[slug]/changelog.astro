---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChangelogList from '../../../components/ChangelogList.astro';
import CurseForgeButton from '../../../components/CurseForgeButton.astro';
import ModNav from '../../../components/ModNav.astro';
import { getDownloadCount, getProjectReleases } from '../../../lib/curseforge';
import { getGuidesForModpack, getModpacks } from '../../../lib/content';

export async function getStaticPaths() {
  const packs = await getModpacks();
  return packs.map((pack) => ({ params: { slug: pack.id } }));
}

const { slug } = Astro.params;
const packs = await getModpacks();
const pack = packs.find((entry) => entry.id === slug);
if (!pack) {
  return Astro.redirect('/');
}

const guides = await getGuidesForModpack(pack.id);
const releases = await getProjectReleases(pack.data.curseforgeProjectId);
const downloads = await getDownloadCount(pack.data.curseforgeProjectId);
---

<BaseLayout title={`Changelog · ${pack.data.name}`} description={`Update history for ${pack.data.name}.`} accent={pack.data.accent}>
  <div class="mx-auto grid min-w-0 max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[16rem_minmax(0,1fr)] sm:px-6">
    <ModNav mod={pack} guides={guides} current="changelog" kind="modpack" />
    <article class="min-w-0 overflow-x-clip">
      <p class="text-xs uppercase tracking-wider text-gold sm:tracking-[0.28em]">
        <a href={`/modpacks/${pack.id}`} class="break-words hover:text-gold-soft">{pack.data.name}</a>
      </p>
      <h1 class="mt-3 font-display text-4xl text-white sm:text-5xl">Changelog</h1>
      <p class="mt-3 text-sm text-muted">Every CurseForge file, newest first.</p>
      <div class="mt-6">
        <CurseForgeButton mod={pack} downloads={downloads} />
      </div>
      <ChangelogList releases={releases} curseforgeUrl={pack.data.curseforgeUrl} />
    </article>
  </div>
</BaseLayout>
